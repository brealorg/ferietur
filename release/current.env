RELEASE_SCHEMA=1
CANONICAL_REPO=brealorg/ferietur

# 0.6.3 transaction opened 2026-10-14 (copy-only: cost-split note and Helseetaten reply ref.
# 26/2867-3 on the payment step and in the PDF; no calculation change). The complete 0.6.2
# record, including its Play production publication on 2026-10-02, is preserved in
# release/history/0.6.2.env. Nothing below claims that any 0.6.3 artifact exists yet.
VERSION_NAME=0.6.3
VERSION_CODE=57
TAG=v0.6.3

APP_SOURCE_QUALIFIED_COMMIT=PENDING
APP_SOURCE_QUALIFICATION=PENDING
APP_SIGNING_CERT_SHA256=9bc0c2925d6bad3947cbcf6c237d6d085aebf5cb54f67170622ce02f8e8252e7

# Account-level Play facts carried over unchanged from the 0.6.2 record.
PLAY_UPLOAD_KEY_GENERATION=v2
PLAY_UPLOAD_CERT_SHA256=064d8a1ff950e4b8a743dbd7c23ad3b80252ecd82c13a297670b26ea357390dc
PLAY_UPLOAD_CREDENTIAL_STORAGE=1PASSWORD
PLAY_UPLOAD_CREDENTIAL_ITEM='Ferietur - Google Play upload key'
PLAY_UPLOAD_KEY_ALIAS=ferietur-play-upload
PLAY_UPLOAD_KEY_PRIVATE_KEY_ACCESS=VERIFIED
PLAY_UPLOAD_KEY_CERT_MATCH_PLAY=PASS
PLAY_UPLOAD_KEY_RESET_STATUS=CANCELED
PLAY_PRODUCTION_ACCESS_STATUS=GRANTED
PLAY_MANAGED_PUBLISHING=ON
PLAY_RELEASE_TRACK=PRODUCTION
PLAY_RELEASE_COUNTRIES=NO

# Play production holds 0.6.2 (versionCode 56); 0.6.3 has not been built for Play.
PLAY_LIVE_VERSION_CODE=56
PLAY_LIVE_VERSION_NAME=0.6.2
PLAY_AAB_STATUS=PENDING
PLAY_RELEASE_STATUS=NOT_STARTED
PLAY_SIGNED_UNIVERSAL_APK_STATUS=NOT_REQUIRED
PLAY_STORE_LISTING_LANGUAGES=no-NO,en-GB
PLAY_STORE_LISTING_EN_STATUS=PUBLISHED
PLAY_STORE_ICON=ICON02_LUGGAGE_TAG

# GitHub still publishes 0.6.2; README states source 0.6.3 and published APK 0.6.2.
GITHUB_RELEASE_STATUS=PUBLISHED
README_PUBLISHED_RELEASE=0.6.2
README_PUBLISHED_VERSION_CODE=56
README_SOURCE_VERSION=0.6.3
README_SOURCE_VERSION_CODE=57

RELEASE_STATE=SOURCE_0.6.3_OPEN_NO_ARTIFACTS
NEXT_ACTION=Qualify_source_then_sign_APK_and_AAB_57

